import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
         
        int a=0;
        int b=0;
        int count=0;
        
        int matrix[][] = new int[5][5];
        for(int i =0;i<5;i++){
            for(int j =0;j<5;j++){
                matrix[i][j]=sc.nextInt();

                if(matrix[i][j]==1){
                   a=i;
                   b=j;
                }
            }
        }

      

        System.out.println(Math.abs(a-2)+Math.abs(b-2));
        

        sc.close();
    }
}
