import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
         
        String s = sc.nextLine();
        int count[] = new int[4];
    
        for(int i=0;i<s.length();i++){
            if(s.charAt(i)!='+'){
              count[s.charAt(i)-'0']++;
            }
        }
        StringBuilder ans = new StringBuilder();

        for(int num=1;num<=3;num++){
           while (count[num]>0) {
            if(ans.length()>0){
                ans.append("+");
            }
            ans.append(num);
            count[num]--;
           }
        }

        System.out.println(ans);

        sc.close();
    }
}
