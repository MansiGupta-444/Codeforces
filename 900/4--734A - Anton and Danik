import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        sc.nextLine();
        String s= sc.nextLine();

       int count_A=0;
       int count_D=0;

       for(int i =0;i<n;i++){
        if(s.charAt(i)=='A'){
            count_A++;
        }else{
            count_D++;
        }
       }
       if(count_A>count_D){
        System.out.println("Anton");
       }  
       else if(count_D>count_A){
        System.out.println("Danik");
       }else{
        System.out.println("Friendship");
       }

        sc.close();
    }
}
